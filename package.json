{
  "name": "tinyerpv3-sdk",
  "version": "1.0.0",
  "description": "SDK for TinyERP v3 API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "dev": "ts-node --esm src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "clean": "rm -rf dist",
    "prettier": "prettier --cache true --write .",
    "prettier:check": "prettier --check .",
    "prepublishOnly": "yarn clean && yarn build",
    "prepare": "husky || true"
  },
  "keywords": [
    "tinyerp",
    "sdk",
    "api",
    "v3",
    "typescript",
    "esm"
  ],
  "author": "linkiez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkiez/TinyERPv3-SDK.git"
  },
  "homepage": "https://github.com/linkiez/TinyERPv3-SDK#readme",
  "bugs": {
    "url": "https://github.com/linkiez/TinyERPv3-SDK/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.10.3",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "form-data": "^4.0.1"
  }
}
